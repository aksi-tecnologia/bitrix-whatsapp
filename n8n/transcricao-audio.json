    {
      "parameters": {
        "method": "POST",
        "url": "https://SEU-PORTAL.bitrix24.com.br/rest/ID_USUARIO/TOKEN_DO_WEBHOOK/im.message.add",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"DIALOG_ID\": \"{{ $('Webhook').item.json.body.dialogId }}\",\n  \"MESSAGE\": {{ ('🎙 Transcrição do áudio #' + $('Webhook').item.json.body.messageId + ':\\n' + $json.text).toJsonString() }},\n  \"SYSTEM\": \"Y\",\n  \"REPLY_ID\": \"{{ $('Webhook').item.json.body.messageId }}\"\n} ",
        "options": {}
